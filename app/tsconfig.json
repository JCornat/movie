{
  "compilerOptions": {
    "module": "NodeNext",
    "strict": true,
    "baseUrl": ".",
    "skipLibCheck": true,
    "paths": {
      "@class/*": [
        "class/*"
      ],
      "@config/*": [
        "config/*"
      ],
      "@controller/*": [
        "controller/*"
      ],
      "@middleware/*": [
        "middleware/*"
      ],
      "@model/*": [
        "model/*"
      ]
    }
  }
}
